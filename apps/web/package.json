    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@iptv/core": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noriginmedia/norigin-spatial-navigation": "^3.4.0",
    "@sentry/react": "^11.13.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
