    "mpegts.js": "^1.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
