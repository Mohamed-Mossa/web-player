{
  "name": "@iptv/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/ota.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "dev:mock": "vite --mode mock",
    "build:mock": "vite build --mode mock",
    "cap:sync": "cap sync android",
    "build:tizen": "vite build --mode tizen && node scripts/check-tizen.mjs && node scripts/package-tizen.mjs",
    "build:tizen:mock": "TIZEN=1 vite build --mode mock --outDir dist-tizen-mock && node scripts/check-tizen.mjs dist-tizen-mock"
  },
